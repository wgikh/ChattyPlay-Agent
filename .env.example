# 复制为 .env.local（本地开发）或在 GitHub/Vercel 中配置为环境变量。
# 说明：只有以 VITE_ 开头的变量会被打包进前端。

# ===== 前端 -> 后端 API 基地址（部署到 GitHub Pages 时必填 HTTPS）=====
# 留空 = 同源；例如 https://your-backend.vercel.app
VITE_API_BASE_URL=

# ===== 后端（api/index.ts，部署到 Vercel / Cloudflare Workers）=====
BCOMIC_API_BASE_URL=https://apis.netstart.cn/bcomic
VIDEO_PARSE_API_BASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
GITHUB_CLIENT_SECRET=
GOOFISH_BACKEND_URL=
CRON_SECRET=

# ===== 第三方 OAuth / 校验 =====
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_HCAPTCHA_SITE_KEY=

# ===== 其它前端功能 =====
VITE_OPENAI_BASE_URL=https://api.deepseek.com
VITE_OPENAI_API_KEY=
VITE_BAIDU_APP_ID=
VITE_BAIDU_SECRET_KEY=
VITE_PAPERS_API_URL=
VITE_ANALYTICS_REPORT_URL=
VITE_AGENT_API_URL=
VITE_NEWS_API_BASE_URL=
VITE_PAY_URL=
VITE_PAY_BEARER_KEY=
VITE_GOOFISH_API_URL=
VITE_GOOFISH_WS_URL=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=